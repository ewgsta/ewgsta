---
import Layout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import BackLink from '../../components/BackLink.astro';
import Pagination from '../../components/Pagination.astro';
import { getProjects, PROJECTS_PER_PAGE } from '../../data/projects';
import { slicePage, totalPages } from '../../data/pagination';
import { url, getSite } from '../../data/site';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const all = await getProjects();
  const total = totalPages(all.length, PROJECTS_PER_PAGE);
  const paths = [];
  for (let page = 2; page <= total; page++) {
    paths.push({ params: { page: String(page) }, props: { page } });
  }
  return paths;
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const [site, all] = await Promise.all([getSite(), getProjects()]);
const slice = slicePage(all, page, PROJECTS_PER_PAGE);
---

<Layout
  title={site.viewAllProjectsLabel}
  description={site.viewAllProjectsLabel}
  noIndex={page > 1}
>
  <section>
    <BackLink href={url('/')} label={site.backToHomeLabel} />

    <SectionHeader title={site.viewAllProjectsLabel} />

    <ul class="project-list">
      {
        slice.items.map((project) => (
          <ProjectItem
            name={project.data.title}
            desc={project.data.description}
            link={project.data.link}
            slug={project.slug}
            showReadMore={true}
          />
        ))
      }
    </ul>

    <Pagination
      basePath={url(`/${site.projectsSlug}`)}
      currentPage={slice.page}
      totalPages={slice.totalPages}
    />

    <div class="page-bottom-spacer"></div>
  </section>
</Layout>