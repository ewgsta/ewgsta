---
import Layout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import BackLink from '../../components/BackLink.astro';
import Pagination from '../../components/Pagination.astro';
import { getProjects, PROJECTS_PER_PAGE } from '../../data/projects';
import { slicePage } from '../../data/pagination';
import { url, getSite } from '../../data/site';
import { listDescription } from '../../utils/seo';

const [site, all] = await Promise.all([getSite(), getProjects()]);
const slice = slicePage(all, 1, PROJECTS_PER_PAGE);
const itemListJsonLd = {
  '@type': 'ItemList',
  name: site.viewAllProjectsLabel,
  itemListElement: slice.items.map((project, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(
      url(`/${site.projectsSlug}/${project.slug}`),
      site.siteUrl
    ).toString(),
  })),
};
---

<Layout
  title={site.viewAllProjectsLabel}
  description={listDescription(
    site.viewAllProjectsLabel,
    site.siteTitle,
    all.map((p) => p.data.title)
  )}
  breadcrumb={[
    { name: site.viewAllProjectsLabel, path: `/${site.projectsSlug}` },
  ]}
  jsonLd={itemListJsonLd}
>
  <section>
    <BackLink href={url('/')} label={site.backToHomeLabel} />

    <SectionHeader title={site.viewAllProjectsLabel} level="h1" />

    <ul class="project-list">
      {
        slice.items.map((project) => (
          <ProjectItem
            name={project.data.title}
            desc={project.data.description}
            link={project.data.link}
            slug={project.slug}
            showReadMore={true}
          />
        ))
      }
    </ul>

    <Pagination
      basePath={url(`/${site.projectsSlug}`)}
      currentPage={1}
      totalPages={slice.totalPages}
    />

    <div class="page-bottom-spacer"></div>
  </section>
</Layout>